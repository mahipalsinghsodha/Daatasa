# ════════════════════════════════════════════════════════════
# DhaniFresh Ghee E-Commerce — Environment Variables
# ════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# ─── SERVER ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── DATABASE ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ghee-ecommerce

# ─── AUTH ─────────────────────────────────────────────────
# Main JWT secret (access tokens, 15min expiry)
JWT_SECRET=change-this-to-a-secure-64-char-random-string

# Refresh token secret (7d expiry, stored in httpOnly cookie)
# If not set, falls back to JWT_SECRET
JWT_REFRESH_SECRET=change-this-to-a-different-64-char-random-string

# Session secret for express-session (Passport.js OAuth)
SESSION_SECRET=change-this-to-yet-another-64-char-random-string

# Cookie signing secret
COOKIE_SECRET=change-this-to-a-cookie-signing-secret

# ─── GOOGLE OAUTH ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── EMAIL (Nodemailer) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
# Note: Use Gmail App Password (not your regular password)
# Go to: Google Account → Security → 2FA → App Passwords
EMAIL_FROM="DhaniFresh <noreply@dhanifresh.com>"
CONTACT_RECEIVER=admin@dhanifresh.com

# ─── PAYMENT (Razorpay) ───────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Get from: https://dashboard.razorpay.com/app/keys

# ─── CLOUDINARY (Image Storage) ───────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Get from: https://cloudinary.com/console

# ─── AI CHAT (Anthropic Claude) ───────────────────────────
# Required for AI bot support. Falls back to rule-based if not set.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx
# Get from: https://console.anthropic.com/

# ─── REDIS (Optional — for distributed rate limiting) ─────
# If not set, falls back to in-memory rate limiting
# REDIS_URL=redis://localhost:6379

# ─── SMS/OTP (Optional) ───────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
